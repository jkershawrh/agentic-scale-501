{
  "name": "agentic-scale-501",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:presentation && npm run build:server",
    "build:presentation": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.build.json && cp server/runtime-package.json server-dist/package.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "start:server": "node server-dist/server/main.js",
    "test": "vitest run && vitest run --config server/vitest.config.ts && npm run test:qualification",
    "test:qualification": "node scripts/test-qualification-runner.mjs",
    "test:visual": "playwright test",
    "test:contracts": "python3 contracts/telemetry/validate_contracts.py",
    "test:showroom": "npm --prefix showroom run check",
    "test:helm": "helm lint charts/agentic-scale-501 && node scripts/verify-helm-routes.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check": "npm run test && npm run typecheck:server && npm run build && npm run verify:offline && npm run test:contracts && npm run test:showroom && npm run test:helm",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
