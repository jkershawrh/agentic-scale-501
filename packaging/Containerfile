FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/nodejs-22@sha256:90d19cd1a4ba03bcb63c46320862955fc1560511532ee35ff472289bf5fe2276 AS build

WORKDIR /opt/app-root/src
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY --chown=1001:0 index.html tsconfig*.json vite.config.ts ./
COPY --chown=1001:0 public ./public
COPY --chown=1001:0 src ./src
RUN npm run build:presentation

FROM --platform=linux/amd64 cgr.dev/chainguard/nginx@sha256:c215e9f4b14bfc2cce3fe748e0d337dbefa8d79a1a1f98f776136d2c3ec89e93

LABEL org.opencontainers.image.title="Agentic AI 501 rehearsal presentation" \
      org.opencontainers.image.description="Static rehearsal presentation; live execution and certification are not included" \
      org.opencontainers.image.vendor="Red Hat and Intel demo packaging" \
      org.opencontainers.image.source="https://github.com/jkershawrh/agentic-scale-501" \
      org.opencontainers.image.architecture="amd64"

COPY --from=build /opt/app-root/src/dist /usr/share/nginx/html
COPY packaging/nginx-main.conf /etc/nginx/nginx.conf
COPY packaging/nginx.conf /etc/nginx/conf.d/nginx.default.conf

EXPOSE 8080
