{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redhat.com/schemas/agentic-501-evaluation-set-v1.json",
  "title": "Agentic AI 501 deterministic evaluation set",
  "description": "Versioned cases for deterministic quality scoring. This contract contains no approval threshold and grants no promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "scorerVersion", "aggregation", "cases"],
  "properties": {
    "schemaVersion": { "const": "agentic-501-evaluation-set/v1" },
    "id": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/text" },
    "scorerVersion": { "$ref": "#/$defs/text" },
    "aggregation": { "const": "arithmetic-mean" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/exactValue" },
          { "$ref": "#/$defs/classification" },
          { "$ref": "#/$defs/retrieval" }
        ]
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "base": {
      "type": "object",
      "required": ["id", "sequence", "class"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "sequence": { "type": "integer", "minimum": 1 },
        "class": { "enum": ["exact-value", "classification", "retrieval"] }
      }
    },
    "exactValue": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sequence", "class", "comparison", "expected"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "sequence": { "type": "integer", "minimum": 1 },
            "class": { "const": "exact-value" },
            "comparison": { "enum": ["strict", "normalized-text"] },
            "expected": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      ]
    },
    "classification": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sequence", "class", "labels", "expectedLabel"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "sequence": { "type": "integer", "minimum": 1 },
            "class": { "const": "classification" },
            "labels": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "expectedLabel": { "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "retrieval": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sequence", "class", "expectedItems"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "sequence": { "type": "integer", "minimum": 1 },
            "class": { "const": "retrieval" },
            "expectedItems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    }
  }
}
